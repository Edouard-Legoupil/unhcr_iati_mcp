{
  "name": "unhcr-iati-mcp",
  "type": "mcp",
  "transport": "stdio",
  "command": "python3",
  "args": [
    "-m",
    "unhcr_iati_mcp.server"
  ],
  "cwd": "/home/edouard/python/unhcr_iati_mcp",
  "env": {
    "IATI_API_KEY": "${IATI_API_KEY}",
    "MCP_TRANSPORT": "stdio",
    "LOG_LEVEL": "DEBUG"
  },
  "timeout": 60,
  "description": "UNHCR IATI MCP Server for accessing humanitarian aid data"
}
